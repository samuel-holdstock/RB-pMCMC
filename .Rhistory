    var_exact = get_variance_exact("BDI",theta,tout,lvls[k],x,obs,results$lower,results$upper,lower_limit,upper_limit) 
    box_results = rbind(box_results,data.frame("lower"=results$lower,"upper"=results$upper,"PVR"=1-var_fast,"goal"=lvls[i],"Q1"=results$Q1,"tau"=lvls[k],"col"=col[k],"type"="brownian_fast"))
    box_results = rbind(box_results,data.frame("lower"=results$lower,"upper"=results$upper,"PVR"=1-var,"goal"=lvls[i],"Q1"=results$Q1,"tau"=lvls[k],"col"=col[k],"type"="brownian"))
    box_results = rbind(box_results,data.frame("lower"=results$lower,"upper"=results$upper,"PVR"=1-var_exact,"goal"=lvls[i],"Q1"=results$Q1,"tau"=lvls[k],"col"=col[k],"type"="exact"))
  }
  # lines(box_results$goal,box_results$PVR,col=col[k])
}
