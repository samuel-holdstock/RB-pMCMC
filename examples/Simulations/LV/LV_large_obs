get_Z = function(z){
  Z = data.frame(matrix(nrow=length(z),ncol=2))
  colnames(Z)=c('time','group')
  for(i in 1:ncol(z)){
    Z[i*nrow(z)+(1:nrow(z)),1] = z[,i]
    Z[i*nrow(z)+(1:nrow(z)),2] = i
  }
  return(Z)
}

