benchmark_cexpm = function(){
  set.seed(1)
  results = list()
  for(k in 0:15){
    total_time = c()
    exp_time = c()
    gillespie_time = c()
    for(i in 1:100){
      d1 = RB_particle_filter_debug("LV",x,theta,tout_list,obs_list-k,obs_list+k,tau_list,obs_list_noise,1000)
      total_time = c(total_time,sum(sapply(tout_list,function(x){d1[[x]]$entire_time}))*10^(-6))
      exp_time = c(exp_time,sum(sapply(tout_list,function(x){d1[[x]]$exp_time}))*10^(-6))
      gillespie_time = c(gillespie_time,d1[[1]]$sum(sapply(tout_list,function(x){d1[[x]]$gillespie_time}))*10^(-6))
    }
    df = data.frame(total_time=total_time,exp_time=exp_time,gillespie_time=gillespie_time)
    results[[k+1]]=df
  }
  return(results)
}
