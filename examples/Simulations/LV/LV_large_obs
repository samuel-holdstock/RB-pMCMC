check_estimators = function(xt_data,xttau_data,inS){
  estimate = run_algorithm("LV",x,theta,tout_list[1],lower_list[1,],upper_list[1,],tau_list[1])
  estimate$xt_data = xt_data
  estimate$xttau_data = xttau_data
  estimate$inS = inS

  Q = get_coffin_matrix("LV",lower_list[1,],upper_list[1,],theta)
  P = cexpm(Q*tau_list[1])
  v = rep(0,nrow(Q))
  v[state_to_index(obs_list[1,],lower_list[1,],upper_list[1,])+1] = 1
  vP = vT_exp_Q(v,t(Q)*tau_list[1,],1e-20,F,T,F)

  estimator = get_estimate(estimate,lower_list[1,],upper_list[1,],vP,obs_list[1,])
  estimator_P = get_estimate_noise_P2(estimate,lower_list[1,],upper_list[1,],P,obs_list[1,],Pf)
  c(estimator,estimator_P)
}
