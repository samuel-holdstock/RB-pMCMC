get_particle_ESS = function(num_particles = 10000){
  set.seed(1)
  d2 = frac_particle_filter_debug("LV",x,theta,tout_list,obs_list_noise,num_particles)
  for(i in 1:length(d2)){
    if(d2[[i]]$log_prob==0){
      stop(paste0("Prob 0. Obs: ",i))
    }
  }
  set.seed(1)
  d1 = RB_particle_filter_debug("LV",x,theta,tout_list,lower_list,upper_list,tau_list,obs_list_noise,num_particles)
  set.seed(1)
  d3 = RB_particle_filter_debug("LV",x,theta,tout_list,lower_list-1,upper_list+1,tau_list,obs_list_noise,num_particles)
  set.seed(1)
  d4 = RB_particle_filter_debug("LV",x,theta,tout_list,lower_list+1,upper_list-1,tau_list,obs_list_noise,num_particles)

  M = get_box_details_string(d1,tout_list)
  plot(c(0, 1), c(0, 1), ann = F, bty = 'n', type = 'n', xaxt = 'n', yaxt = 'n')
  text(x = 0.33, y = 0.5, M[[1]], 
      cex = 1.6, col = "black")
  text(x = 0.66, y = 0.5, M[[2]], 
      cex = 1.6, col = "black")
  text(x = 0.56, y = 0.15, paste0("Theta: ",toString(theta)), 
      cex = 1, col = "black")
  text(x = 0.56, y = 0.10, paste0("(True Theta: ",toString(c(0.5,0.0025,0.3)),")"), 
      cex = 1, col = "black")
  
  results = matrix(nrow=length(tout_list),ncol=4)
  colnames(results) = c('Frac','RB','RB_big','RB_small')
  rownames(results) = tout_list
  for(i in 1:length(tout_list)){
    results[i,] = c(
      sum(d2[[i]]$weights)^2/sum(d2[[i]]$weights^2),
      sum(d1[[i]]$particle_weights)^2/sum(d1[[i]]$particle_weights^2),
      sum(d3[[i]]$particle_weights)^2/sum(d3[[i]]$particle_weights^2),
      sum(d4[[i]]$particle_weights)^2/sum(d4[[i]]$particle_weights^2)
    )
  }
  return(results/num_particles)
}

